# ── Banco (Supabase / Postgres) ─────────────────────────────────────────────
# Conexão com pgbouncer (pooling) — usada pelo app em runtime
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta — usada apenas pelo Prisma Migrate.
# OBRIGATÓRIA: sem ela o `prisma validate`/`migrate` falha com P1012.
DIRECT_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# ── Alternativa: Postgres local via Docker ──────────────────────────────────
# Para desenvolver sem depender do Supabase, use `npm run db:up` (o
# docker-compose.yml da raiz do backend) e troque as DUAS linhas acima por
# estas. Aqui não há pgbouncer, então as duas apontam para a mesma porta.
#
# DATABASE_URL="postgresql://profdex:profdex@localhost:55432/profdex"
# DIRECT_URL="postgresql://profdex:profdex@localhost:55432/profdex"

# ── Aplicação ───────────────────────────────────────────────────────────────
# `development` liga o CADASTRO DIRETO por matrícula/nome/senha
# (POST /auth/register + a tela /register no front). Existe porque o OAuth do
# Google não roda fora de localhost — o Google recusa IP cru e exige HTTPS —,
# então testar o app pelo IP da rede precisaria de um túnel.
#
# ⚠️ NUNCA use `development` em produção: o cadastro direto cria conta SEM
# e-mail institucional verificado. Qualquer outro valor (ou nenhum) mantém a
# rota em 404. Ver src/auth/dev-signup.ts.
NODE_ENV="development"

# Assina o cookie de sessão (HttpOnly, path=/api, 15min) e é a MESMA chave que
# o gateway de batalha usa para validar o handshake do WebSocket.
JWT_SECRET="troque-por-uma-chave-secreta-longa-e-aleatoria"

# Origens liberadas no CORS (HTTP e WebSocket), separadas por vírgula.
CORS_ORIGINS="http://localhost:5173"

PORT=3000

# Senha da conta de administração criada pelo seed (matrícula "admin").
# Sem esta variável a senha é "123456" — cômoda para digitar no tablet da
# bancada, péssima para um servidor exposto. O seed REESCREVE a senha dessa
# conta a cada execução, então mudar aqui e rodar `npm run db:seed` basta.
ADMIN_PASSWORD=""

# URL do FRONT — destino dos redirects do login com Google e base do link de
# redefinição de senha. Sem barra no final.
APP_URL="http://localhost:5173"

# ── Login com Google (opcional) ─────────────────────────────────────────────
# Sem GOOGLE_CLIENT_ID o app sobe normalmente; apenas as rotas /auth/google
# não existem e o botão do front não funciona.
#
# Criar em https://console.cloud.google.com → APIs e Serviços → Credenciais →
# ID do cliente OAuth → Aplicativo da Web. Custo: zero.
# Em "URIs de redirecionamento autorizados", cadastre exatamente o
# GOOGLE_CALLBACK_URL abaixo.
#
# Só e-mails @edu.unifil.br (aluno) e @unifil.br (admin) são aceitos — a
# validação é no servidor, ver src/auth/institutional-domains.ts
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# ── E-mail (redefinição de senha) ───────────────────────────────────────────
# Sem RESEND_API_KEY nada é enviado: o e-mail (com o link) vai para o LOG do
# servidor. É o comportamento desejado em desenvolvimento.
#
# Grátis: Resend (3.000/mês, 100/dia) em https://resend.com
# Alternativa: Brevo (300/dia). Trocar exige mexer só em src/mail/mail.service.ts
RESEND_API_KEY=""
MAIL_FROM="ProfDex <onboarding@resend.dev>"

# ── Teste de carga do PvP (opcional) ────────────────────────────────────────
# Só é lido por scripts/loadtest/. Ver scripts/loadtest/README.md.

# Servidor sob teste (sem /api no final).
LOAD_WS_URL="http://localhost:3000"

# Segundos que cada "espectador de lobby" fica conectado parado.
# A concorrência alcançada é ~ arrivalRate * peso_do_cenario * este valor.
LOAD_LOBBY_HOLD_S=60

# Fração dos espectadores que abre a lista de jogadores (lobby:subscribe).
# Só esses recebem eventos de presença — 0.2 modela "a maioria com a tela
# de jogadores fechada", que é o comportamento real.
LOAD_LOBBY_SUBSCRIBE_RATIO=0.2

# Teto de turnos antes de considerar a batalha travada.
LOAD_MAX_TURNS=40

# Quanto esperar por um evento do servidor antes de contar como falha (ms).
LOAD_EVENT_TIMEOUT_MS=20000
