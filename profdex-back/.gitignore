/dist
/node_modules
/build

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
# backups do .env também carregam segredos (JWT_SECRET, credenciais do banco)
.env.bak
.env.*.bak
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# QR Codes de captura gerados — contem tokens em texto puro
/qr-out

# Cache incremental do tsc (gerado por `tsc -p tsconfig.build.json`).
/*.tsbuildinfo

# Schema SQLite de desenvolvimento local. O comentario no topo dele ja dizia
# "ignorado em .gitignore", mas a linha nunca existiu — o arquivo so nunca
# tinha sido adicionado. Ele esta obsoleto (ver o aviso no proprio arquivo) e
# versiona-lo convidaria a usar um schema que nao roda o app.
/prisma/schema.local.prisma
