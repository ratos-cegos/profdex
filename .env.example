# .env da raiz — usado pelo docker-compose.yml (stack completa: frontend +
# backend + Postgres + Adminer + nginx). Copie para `.env` e preencha valores
# reais; NUNCA versione o `.env` de verdade (já está no .gitignore).
#
# Isto é separado do profdex-back/.env.example, que é usado para rodar o
# backend fora do Docker (`npm run start:dev`) e documenta Supabase/OAuth/etc.
# em detalhe — as mesmas variáveis de app valem aqui.

# ── Domínio / nginx ──────────────────────────────────────────────────────────
DOMAIN=profdex.unifil.tech

# ── Adminer (HTTP Basic Auth no nginx, antes do login do Postgres) ─────────
# Gere uma senha forte com:
#   openssl rand -base64 32
ADMINER_AUTH_USER=admin
ADMINER_AUTH_PASSWORD=change-me

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=profdex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=profdex

# `db` é o hostname do serviço na rede Docker interna — não `localhost`
# (dentro do container do Adminer ou do app, `localhost` é o próprio
# container, não o Postgres).
DATABASE_URL="postgresql://profdex:change-me@db:5432/profdex"
DIRECT_URL="postgresql://profdex:change-me@db:5432/profdex"

# ── Aplicação (backend) ──────────────────────────────────────────────────────
NODE_ENV=production

# Assina o cookie de sessão e o handshake do WebSocket — ver
# profdex-back/src/auth/auth-session.ts.
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# Mesma origem do front, agora que tudo está atrás do mesmo domínio.
CORS_ORIGINS=https://profdex.unifil.tech

PORT=3000

# Senha da conta admin criada pelo seed (matrícula "admin").
ADMIN_PASSWORD=""

# URL pública do front — mesma origem, sem barra no final.
APP_URL=https://profdex.unifil.tech

# ── Login com Google (opcional) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL=https://profdex.unifil.tech/api/auth/google/callback

# ── E-mail (redefinição de senha, opcional) ─────────────────────────────────
RESEND_API_KEY=""
MAIL_FROM="ProfDex <onboarding@resend.dev>"
